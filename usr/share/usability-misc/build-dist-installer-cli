#!/bin/bash

#set -x
set -o errexit
set -o nounset
set -o errtrace
set -o pipefail
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "${0}: START"

MYDIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
cd -- "${MYDIR}"
cd -- ..
cd -- ..
cd -- ..

## For future use in case of issues.
## Building dist-installer-cli is not crucial and a workaround to skip it might unbreak the build process.
## https://forums.whonix.org/t/derivative-maker-missing-usr-libexec-helper-scripts-get-colors-sh/20142
if [ "${dist_build_skip_installer_dist_standalone:-}" = "true" ]; then
  printf '%s\n' "${0}: INFO: Skipping to build dist-installer-cli because dist_build_skip_installer_dist_standalone=true, ok."
  exit 0
fi

## style-ok: no-has -- self-contained.
command -v git >/dev/null || exit 1

toplevel="$(git rev-parse --show-toplevel)"
target="${toplevel}/usr/share/usability-misc/dist-installer-cli-standalone"
template="${toplevel}/usr/bin/dist-installer-cli"
base_name_target="${target##*/}"

## debian/control cannot Build-Depend on helper-scripts without severely
## complicating our build setup. Every supported caller exports
## HELPER_SCRIPTS_PATH at the pinned helper-scripts checkout (help-steps/pre,
## parse-cmd, variables; dist-ai-tests-all in CI). Refuse when unset rather
## than silently inlining the installed /usr/libexec copy, which drifts from
## the pinned checkout.
if [ -z "${HELPER_SCRIPTS_PATH:-}" ]; then
  printf '%s\n' "${0}: ERROR: HELPER_SCRIPTS_PATH is unset. Set it to the helper-scripts checkout (the build and CI export it)." >&2
  exit 1
fi
helper_path="${HELPER_SCRIPTS_PATH}/usr/libexec/helper-scripts/"

if ! test -d "${helper_path}" ; then
  printf '%s\n' "${0}: ERROR: directory helper_path '${helper_path}' does not exist!" >&2
  exit 1
fi

canonical_helper_dir="/usr/libexec/helper-scripts/"
## TODO: This is a no-op, why do we need this?
helper_dir="${helper_path%/}/"

declare -A pasted_helper_files

extract_helper_source() {
  local line="${1}"
  local path
  local rel

  ## Supported:
  ##   source /usr/libexec/helper-scripts/foo.bsh
  ##   source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/foo.bsh
  if [[ ! "${line}" =~ ^[[:space:]]*source[[:space:]]+([^[:space:];#]+) ]]; then
    return 1
  fi

  path="${BASH_REMATCH[1]}"

  ## Remove quotes.
  path="${path//\"/}"
  path="${path//\'/}"

  ## Remove optional variable prefix used by helper-scripts.
  path="${path//\$\{HELPER_SCRIPTS_PATH:-\}/}"
  path="${path//\$HELPER_SCRIPTS_PATH/}"

  ## Only inline helper-scripts imports.
  if [[ "${path}" == "${canonical_helper_dir}"* ]]; then
    rel="${path#"${canonical_helper_dir}"}"
    printf '%s\n' "${helper_dir}${rel}"
    return 0
  fi

  if [[ "${path}" == "${helper_dir}"* ]]; then
    printf '%s\n' "${path}"
    return 0
  fi

  return 1
}

paste_helper_file() {
  local file="${1}"
  ## Normalize the path embedded in the built file for reproducibility.
  local display="${canonical_helper_dir}${file#"${helper_dir}"}"

  if [[ -n "${pasted_helper_files[${display}]+x}" ]]; then
    printf '%s\n' "##### SKIP duplicate source import from file ${display}"
    return 0
  fi

  pasted_helper_files["${display}"]=1

  if ! test -f "${file}" ; then
    printf '%s\n' "${0##*/}: ERROR: sourced file does not exist: ${file}" >&2
    exit 1
  fi

  printf '%s\n' "##### BEGIN pasted by ${0##*/} from file ${display}"
  process_file "${file}"
  printf '%s\n' "##### END pasted by ${0##*/} from file ${display}"
}

process_file() {
  local file="${1}"
  local line=""
  local source_file

  while IFS= read -r line || test -n "${line}"; do
    if source_file="$(extract_helper_source "${line}")"; then
      paste_helper_file "${source_file}"
      continue
    fi

    printf '%s\n' "${line}"
  done < "${file}"
}

cp -- "${template}" "${target}"

tmp_target="$(mktemp "${target}.tmp.XXXXXXXXXX")"
cleanup_handler() {
  ## style-ok: no-safe-rm -- own mktemp temp file; build-time generator, no shell shadow
  rm -f -- "${tmp_target}"
}
trap cleanup_handler EXIT

process_file "${target}" > "${tmp_target}"

chmod --reference="${target}" "${tmp_target}"
mv -- "${tmp_target}" "${target}"

trap - EXIT

sed -i \
  -e "6i\\
##########################\\
## NOTE:\\
## AUTOGENERATED CODE!\\
## DO NOT MODIFY THIS '${base_name_target}' FILE!\\
## INSTEAD MODIFY ../../bin/dist-installer-cli and the functions sourced!\\
##########################\\
" \
  -- \
  "${target}"

printf '%s\n' "${0}: INFO: BUILD: SUCCESS"
printf '%s\n' "${0}: INFO: Running shellcheck..."

shellcheck "${target}"

printf '%s\n' "${0}: INFO: shellcheck: SUCCESS"
printf '%s\n' "${0}: INFO: END: OK"
